<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<div class="question">
    <p class="prompt"><c:out value="${q.question}"/></p>

    <c:if test="${q.questionType == 'PICTURE_RESPONSE' && not empty q.imageUrl}">
        <img class="q-image" src="<c:out value='${q.imageUrl}'/>" alt="question image"/>
    </c:if>

    <c:choose>
        <c:when test="${q.questionType == 'MULTIPLE_CHOICE'}">
            <c:forEach var="opt" items="${optionsMap[q.id]}">
                <label class="option">
                    <input type="radio" name="q${q.id}" value="<c:out value='${opt.optionText}'/>"/>
                    <c:out value="${opt.optionText}"/>
                </label>
            </c:forEach>
        </c:when>

        <c:otherwise>
            <input type="text" class="answer" name="q${q.id}" placeholder="Your answer"/>
        </c:otherwise>
    </c:choose>
</div>
